{
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "escolaide.vercel.app"
        }
      ],
      "destination": "https://preparacaofamiliar.com.br/:path",
      "permanent": true
    },
    {
      "source": "/ig/:canal/inicio",
      "destination": "/?utm_source=ig&utm_medium=social&utm_campaign=:canal&utm_content=inicio",
      "permanent": false
    },
    {
      "source": "/ig/:canal/comida",
      "destination": "/comida-que-dura?utm_source=ig&utm_medium=social&utm_campaign=:canal&utm_content=comida",
      "permanent": false
    },
    {
      "source": "/ig/:canal/mochila",
      "destination": "/mochila-de-emergencia?utm_source=ig&utm_medium=social&utm_campaign=:canal&utm_content=mochila",
      "permanent": false
    },
    {
      "source": "/ig/:canal/pet",
      "destination": "/mochila-pet?utm_source=ig&utm_medium=social&utm_campaign=:canal&utm_content=pet",
      "permanent": false
    },
    {
      "source": "/ig/:canal/pasta",
      "destination": "/pasta?utm_source=ig&utm_medium=social&utm_campaign=:canal&utm_content=pasta",
      "permanent": false
    },
    {
      "source": "/ig/:canal/cardume",
      "destination": "/cardume?utm_source=ig&utm_medium=social&utm_campaign=:canal&utm_content=cardume",
      "permanent": false
    },
    {
      "source": "/ig/:canal/curso",
      "destination": "/preparacao-familiar?utm_source=ig&utm_medium=social&utm_campaign=:canal&utm_content=curso",
      "permanent": false
    },
    {
      "source": "/ig/:canal/loja",
      "destination": "/loja?utm_source=ig&utm_medium=social&utm_campaign=:canal&utm_content=loja",
      "permanent": false
    },
    {
      "source": "/yt/:canal/inicio",
      "destination": "/?utm_source=youtube&utm_medium=video&utm_campaign=:canal&utm_content=inicio",
      "permanent": false
    },
    {
      "source": "/yt/:canal/comida",
      "destination": "/comida-que-dura?utm_source=youtube&utm_medium=video&utm_campaign=:canal&utm_content=comida",
      "permanent": false
    },
    {
      "source": "/yt/:canal/mochila",
      "destination": "/mochila-de-emergencia?utm_source=youtube&utm_medium=video&utm_campaign=:canal&utm_content=mochila",
      "permanent": false
    },
    {
      "source": "/yt/:canal/pet",
      "destination": "/mochila-pet?utm_source=youtube&utm_medium=video&utm_campaign=:canal&utm_content=pet",
      "permanent": false
    },
    {
      "source": "/yt/:canal/pasta",
      "destination": "/pasta?utm_source=youtube&utm_medium=video&utm_campaign=:canal&utm_content=pasta",
      "permanent": false
    },
    {
      "source": "/yt/:canal/cardume",
      "destination": "/cardume?utm_source=youtube&utm_medium=video&utm_campaign=:canal&utm_content=cardume",
      "permanent": false
    },
    {
      "source": "/yt/:canal/curso",
      "destination": "/preparacao-familiar?utm_source=youtube&utm_medium=video&utm_campaign=:canal&utm_content=curso",
      "permanent": false
    },
    {
      "source": "/yt/:canal/loja",
      "destination": "/loja?utm_source=youtube&utm_medium=video&utm_campaign=:canal&utm_content=loja",
      "permanent": false
    },
    {
      "source": "/wa/:canal/inicio",
      "destination": "/?utm_source=whatsapp&utm_medium=mensagem&utm_campaign=:canal&utm_content=inicio",
      "permanent": false
    },
    {
      "source": "/wa/:canal/comida",
      "destination": "/comida-que-dura?utm_source=whatsapp&utm_medium=mensagem&utm_campaign=:canal&utm_content=comida",
      "permanent": false
    },
    {
      "source": "/wa/:canal/mochila",
      "destination": "/mochila-de-emergencia?utm_source=whatsapp&utm_medium=mensagem&utm_campaign=:canal&utm_content=mochila",
      "permanent": false
    },
    {
      "source": "/wa/:canal/pet",
      "destination": "/mochila-pet?utm_source=whatsapp&utm_medium=mensagem&utm_campaign=:canal&utm_content=pet",
      "permanent": false
    },
    {
      "source": "/wa/:canal/pasta",
